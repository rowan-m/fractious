{
  "name": "fractious",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:node": "audit-ci --config audit-ci.json",
    "audit:rust": "cd wasm && cargo audit",
    "build": "npm run build:wasm && npm run build:web",
    "build:wasm": "wasm-pack build wasm --target web",
    "build:web": "vite build",
    "check": "npm run lint && npm run lint:rust && npm run lint:shaders && npm run audit:node && npm run depcruise",
    "check:size": "bundlesize",
    "clean": "rimraf dist wasm/pkg wasm/target",
    "depcruise": "depcruise src",
    "dev": "vite",
    "format": "npm run format:web && npm run format:rust",
    "format:check": "npm run format:check:web && npm run format:check:rust",
    "format:check:rust": "cd wasm && cargo fmt --check",
    "format:check:web": "prettier --check .",
    "format:rust": "cd wasm && cargo fmt",
    "format:web": "prettier --write .",
    "lint": "eslint src",
    "lint:rust": "cd wasm && cargo clippy --all-targets -- -D warnings",
    "lint:shaders": "wgslender validate src/renderer/shader.wgsl src/renderer/post.wgsl",
    "preview": "vite preview",
    "test": "npm run test:wasm && npm run test:web",
    "test:wasm": "cd wasm && wasm-pack test --node",
    "test:web": "vitest run",
    "update:wasm": "cd wasm && cargo update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "audit-ci": "^7.1.0",
    "bundlesize": "^0.18.2",
    "dependency-cruiser": "^18.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.1",
    "wasm-pack": "^0.15.0",
    "wgslender": "^1.4.1"
  },
  "allowScripts": {
    "wasm-pack@0.15.0": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true
  },
  "bundlesize": [
    {
      "path": "./dist/assets/index-*.js",
      "maxSize": "50 kB"
    },
    {
      "path": "./dist/assets/fractious_lib_bg-*.wasm",
      "maxSize": "300 kB"
    },
    {
      "path": "./dist/assets/worker-*.js",
      "maxSize": "15 kB"
    },
    {
      "path": "./dist/assets/index-*.css",
      "maxSize": "5 kB"
    }
  ]
}
